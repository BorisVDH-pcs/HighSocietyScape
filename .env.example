# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Find these in Supabase: Project Settings -> API.

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Anon/public key — safe for the frontend (read-only via RLS).
SUPABASE_ANON_KEY=

# Service role key — SECRET. Full DB access, bypasses RLS.
# Used ONLY by scripts/syncToSupabase.mjs. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Which WOM competition (season) to sync.
WOM_COMPETITION_ID=145906

# Optional: descriptive User-Agent for WOM API calls.
WOM_USER_AGENT=HighSocietyScape (github.com/BorisVDH-pcs/HighSocietyScape)
