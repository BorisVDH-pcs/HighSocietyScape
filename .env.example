# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# NEVER put real keys in THIS file (.env.example) — it is tracked by git.
# Find these in Supabase: Project Settings -> API.

# Project URL — the base origin ONLY, no trailing path.
# e.g. https://abcdefgh.supabase.co   (do NOT include /rest/v1/)
SUPABASE_URL=

# Anon/publishable key — safe for the frontend (read-only via RLS).
SUPABASE_ANON_KEY=

# Service role / secret key — SECRET. Full DB access, bypasses RLS.
# Used ONLY by scripts/syncToSupabase.mjs. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Which WOM competition (season) to sync.
WOM_COMPETITION_ID=145906

# Optional: descriptive User-Agent for WOM API calls.
WOM_USER_AGENT=HighSocietyScape (github.com/BorisVDH-pcs/HighSocietyScape)

# Optional: WOM API key. Without one the API allows 20 requests/min; with one,
# 100/min (a full 71-player fetch drops from ~4 min to ~45s). The fetcher works
# fine without it (it retries rate-limit errors). Request a key via the WOM
# Discord, then paste it here. Sent as the `x-api-key` header.
WOM_API_KEY=
