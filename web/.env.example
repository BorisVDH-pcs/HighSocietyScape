# Copy this file to `.env` (gitignored) to point the web app at Supabase.
# Both values are the PUBLIC anon/publishable pair (safe to ship in frontend
# code). Find them in Supabase: Project Settings -> API. Leave BOTH blank to
# run fully offline against the bundled snapshot (gear then lives in session
# state only, resetting on reload).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
